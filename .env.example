# Set these in your shell or hosting dashboard; never commit real values.
SETUP_KEY=replace-with-a-long-random-setup-key
DATABASE_PATH=/data/school.db
PORT=8000
# 1 for an HTTPS deployment; 0 for local HTTP development.
COOKIE_SECURE=1

# Vercel: connect a PostgreSQL provider and set DATABASE_URL (or POSTGRES_URL).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_PATH applies ONLY to local/Docker SQLite, not Vercel.
